# Banco de dados MySQL
DB_HOST=192.168.200.136
DB_PORT=3306
DB_NAME=dnpmix
DB_USER=root
DB_PASSWORD=

# API Ponto Certificado
PONTO_API_BASE_URL=https://integrar.pontocertificado.com.br
# Tempo (ms) que um token é reaproveitado pelo backend antes de um novo StartSession
PONTO_TOKEN_TTL_MS=900000
# Timeout (ms) das chamadas à API externa
PONTO_API_TIMEOUT_MS=30000

# API ExataWeb (integração somente leitura, Portaria 671)
# Credenciais globais da conta: cobrem todas as empresas (empresasistema).
EXATA_API_BASE_URL=
EXATA_API_USER=
EXATA_API_PASSWORD=
# Timeout (ms) das chamadas à API Exata
EXATA_API_TIMEOUT_MS=30000
# Tempo (ms) de reaproveitamento do token quando o JWT não traz `exp`
EXATA_TOKEN_TTL_MS=900000

# URL pública HTTPS usada nos callbacks de webhook (ex.: https://ponto.suaempresa.com.br)
# Se vazia, o backend usa o host da requisição.
PUBLIC_BASE_URL=

# Sessão do portal (token entregue ao navegador)
AUTH_SESSION_TTL_MS=43200000

# Seed opcional da primeira empresa (só é inserido se todas as variáveis forem informadas)
SEED_EMPRESA_NOME=
SEED_EMPRESA_EMAIL=
SEED_EMPRESA_SENHA=
SEED_EMPRESA_CHAVE=

# Porta do backend
PORT=3001
